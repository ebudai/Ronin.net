datatype Animal
{
	var id as integer = random.
	var weight as number = random decimal from 1 to 1_000.
	var has fur as maybe = random < 0.98.

	function fight(others as Animal[text])
	{
		resolve to 9.
	}
}

function spawn (n as integer) animals
{
	resolve to new Animal[n].
}

var animals = spawn 753 animals.