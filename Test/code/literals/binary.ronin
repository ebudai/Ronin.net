var normal binary number = 0b101.
var binary number with separators = 0b1000_1010_0100.
var binary double word = 0b1100_0000_0000_0000_1111_0101.
var binary quad word = 0b1010_1010_1001_0111_0010_1001_0010_0001_0111_1101_0101_0100_0101.
var arbitrarily large binary value = 0b1010_1010_1001_0111_0010_1001_0010_0001_0111_1101_0101_0100_0100_1010_1010_1001_0111_0010_1001_0010_0001_0111_1101_0101_0100_0101_0100_0101_0100_0101_0100_0101.